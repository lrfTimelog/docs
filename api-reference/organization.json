{
  "openapi": "3.1.0",
  "info": {
    "title": "TimeLog REST API — Organization",
    "version": "v1, v2",
    "description": "The Organization surface of the TimeLog REST API, reconstructed from source annotations, action signatures, live-captured payloads and published documentation.\n\nEvery field is traceable to one of those sources. Where a contract could not be established it is marked as unknown rather than guessed.\n\nResponses use the TAF envelope: single resources are under `Properties`, collections under `Entities[].Properties`."
  },
  "servers": [
    {
      "url": "https://app{instance}.timelog.com/{account}/api",
      "description": "Your TimeLog site. The URL shown is a placeholder — in the API Explorer, double-click it and paste your own site's base URL, e.g. `https://app3.timelog.com/acme/api`. It is remembered as you move between endpoints, so you only do this once.",
      "variables": {
        "instance": {
          "default": "NN",
          "description": "The number in your TimeLog address: `app3.timelog.com` is instance `3`."
        },
        "account": {
          "default": "YOUR-ACCOUNT",
          "description": "The segment after the host: `app3.timelog.com/acme/` is account `acme`."
        }
      }
    }
  ],
  "security": [
    {
      "personalAccessToken": []
    }
  ],
