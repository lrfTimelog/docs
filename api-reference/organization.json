  "components": {
    "securitySchemes": {
      "personalAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "PAT",
        "description": "Personal Access Token, sent as `Authorization: Bearer <token>`.\n\n**Getting one.** In TimeLog go to Settings → Personal settings → Personal access tokens → *Click here to manage the personal access tokens*. If that section is not visible, your TimeLog administrator must grant your role the Integration privilege for personal access tokens (Security → Roles → Edit). Tokens can be set to expire after up to two years and are shown once.\n\n**Scope.** A PAT acts as the user who created it and carries exactly that user's permissions — there is no narrower scope.\n\n**Not interchangeable.** Reporting API credentials (Site Code, API ID, API Password) do not work against the REST API.\n\n**Set the base URL first.** The URL shown above is a placeholder and will not reach any site. In the API Explorer, double-click it and paste your own — `https://app3.timelog.com/acme/api` for account `acme` on instance 3. It is remembered as you move between endpoints. See *Set up your site* for a field that builds the URL for you.\n\n**Check it works.** `GET /v1/user/me` returns 200 when the token, instance and account are all correct. A 401 means one of the three is wrong; TimeLog does not say which."
      }
    },
    "schemas": {
      "TafLink": {
        "type": "object",
        "description": "A hypermedia link. `Rel` names the relationship, `Href` is the absolute URL.",
        "properties": {
          "Href": {
            "type": "string",
            "format": "uri"
          },
          "Rel": {
            "type": "string"
          },
          "Actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TafAction"
            }
          }
        },
        "required": [
          "Href",
          "Rel"
        ]
      },
      "TafActionField": {
        "type": "object",
        "description": "One field of a TAF action's payload.",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Type": {
            "type": "string"
          },
          "Value": {
            "description": "Free-form JSON value."
          }
        }
      },
      "TafAction": {
        "type": "object",
        "description": "An operation the caller may perform next. `Method` is the `TafRequestMethods` enum, serialised as an integer.",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Method": {
            "type": "integer",
            "format": "int32"
          },
          "Href": {
            "type": "string",
            "format": "uri"
          },
          "Type": {
            "type": "string"
          },
          "Fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TafActionField"
            }
          }
        }
      },
      "TafPagingProperties": {
        "type": "object",
        "description": "Paging counters returned on list responses. Serialised as strings, as observed in the live-capture corpus.",
        "properties": {
          "PageNumber": {
            "type": "string"
          },
          "TotalPage": {
            "type": "string"
          },
          "TotalRecord": {
            "type": "string"
          }
        }
      },
      "DepartmentApiReadModel": {
        "type": "object",
        "properties": {
          "DepartmentID": {
            "type": "integer",
            "format": "int32",
            "description": "Gets or sets the Department identifier."
          },
          "Name": {
            "type": "string",
            "description": "Gets or sets the name."
          },
          "IsActive": {
            "type": "boolean",
            "description": "Gets or sets a value indicating whether this instance is active."
          },
          "No": {
            "type": "string",
            "description": "Gets or sets the No."
          },
          "ID": {
            "type": "string",
            "format": "uuid",
            "description": "Gets or sets the identifier."
          },
          "ParentID": {
            "type": "integer",
            "format": "int32",
            "description": "Gets or sets the Parent identifier."
          },
          "ManagerEmployeeID": {
            "type": "integer",
            "format": "int32",
            "description": "Gets or sets the Manager Employee identifier."
          }
        }
      },
      "UserApiReadModel": {
        "type": "object",
        "description": "No serialisable properties found in source."
      },
      "EmployeeProjectionApiReadModel": {
        "type": "object",
        "properties": {
          "ProjectionID": {
            "type": "integer",
            "format": "int32",
            "description": "Gets or sets the projection identifier."
